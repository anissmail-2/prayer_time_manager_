          color: isSelected 
              ? color.withOpacity(0.15)
              : isDark ? Colors.white.withOpacity(0.05) : Colors.grey.shade100,
          borderRadius: BorderRadius.circular(AppTheme.radiusMedium),
          border: Border.all(
            color: isSelected 
                ? color
                : isDark ? Colors.white.withOpacity(0.1) : Colors.grey.shade300,
